# --- Database ---
# If you have PostgreSQL installed locally, use something like:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/hiresense
#
# If you DON'T have PostgreSQL set up yet and just want to get the app
# running today, use SQLite instead (no setup needed, creates a local file):
DATABASE_URL=sqlite:///./hiresense.db

# --- JWT Auth ---
SECRET_KEY=change_this_to_a_long_random_string_before_real_use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
